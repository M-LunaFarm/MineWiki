[Unit]
Description=Restore and validate the latest verified MineWiki backup
After=network-online.target mysql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/MineWiki
Environment=MINEWIKI_ENV_FILE=/var/www/MineWiki/.env
ExecStart=/usr/bin/flock -n /run/minewiki-backup.lock /usr/bin/node scripts/drill-latest-minewiki-backup.mjs
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true

